#!/usr/bin/env sh
# ----------------------------------------------------------------------------
# Maven Wrapper (sh)
# Resolves the project base directory and executes the maven-wrapper JAR.
# ----------------------------------------------------------------------------
PRG="$0"
while [ -h "$PRG" ]; do
	ls=`ls -ld "$PRG"`
	link=`expr "$ls" : '.*-> \(.*\)$'`
	if expr "$link" : '/.*' > /dev/null; then
		PRG="$link"
	else
		PRG=`dirname "$PRG"`"/$link"
	fi
done
PRGDIR=`dirname "$PRG"`
MAVEN_PROJECTBASEDIR=`cd "$PRGDIR" >/dev/null; pwd`

if [ -n "$JAVA_HOME" ]; then
	JAVA_CMD="$JAVA_HOME/bin/java"
else
	JAVA_CMD=java
fi

exec "$JAVA_CMD" -jar "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" "$@"
